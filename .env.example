# База даних PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=travel_planner_db

# Рядок підключення для FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/travel_planner_db

# Налаштування підключення та портів
DB_PORT=5432
DB_NAME=travel_planner_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

APP_PORT=4567